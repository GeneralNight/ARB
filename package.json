    "scan:once": "tsx src/cli/scan-once.ts",
    "scan:direto": "tsx src/cli/scan-direto.ts",
    "proximos": "tsx src/cli/proximos.ts",
    "sync:competitions": "tsx src/cli/sync-competitions.ts",
    "add:liga": "tsx src/cli/add-liga.ts",
    "buscar": "tsx src/cli/buscar-liga.ts",
    "sondar": "tsx src/cli/sondar.ts",
    "comparar": "tsx src/cli/comparar.ts",
    "divergencia": "tsx src/cli/divergencia.ts",
    "provar:ct": "tsx src/cli/provar-ct.ts",
    "provar:ordem": "tsx src/cli/provar-ordem.ts",
    "auditar": "tsx src/cli/auditar-alertas.ts",
    "simular": "tsx src/cli/simular-lucro.ts",
