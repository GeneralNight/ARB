{
  "name": "arb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Detector de arbitragem 1X2 pre-jogo: Flashscore -> Supabase -> Telegram",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
